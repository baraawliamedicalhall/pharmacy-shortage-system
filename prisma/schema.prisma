datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EMPLOYEE
  RETAILER
}

enum ShortageStatus {
  REPORTED
  REVIEWED
  ORDERED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  DUE
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  BKASH
  BANK
  CREDIT
}

model User {
  id           String     @id @default(cuid())
  employeeId   String     @unique // Employee ID / login code (e.g. EMP001 or admin)
  name         String
  passwordHash String
  role         Role       @default(EMPLOYEE)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  shortages    Shortage[] @relation("ReportedShortages")
  auditLogs    AuditLog[]

  @@index([employeeId])
  @@index([role])
}

model Manufacturer {
  id        String     @id @default(cuid())
  name      String     @unique
  shortName String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  medicines Medicine[]

  @@index([name])
  @@index([isActive])
}

model Medicine {
  id              String        @id @default(cuid())
  brandName       String
  genericName     String
  strength        String
  dosageForm      String        // Tablet, Capsule, Syrup, Suspension, Injection, Ointment, Drop, Inhaler
  manufacturerId  String
  manufacturer    Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  packDescription String?       // e.g., "10x10 blister pack"
  purchaseUnit    String?       @default("Box") // Box, Strip, Bottle
  retailUnit      String?       @default("Tablet") // Tablet, Capsule, Bottle
  searchKeywords  String?       // Synonyms, common misspellings (e.g. "nappa paracitamol")
  barcode         String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Pricing & Pack configuration
  mrp             Float?        // Maximum Retail Price per unit (Tablet/Capsule/Bottle)
  stripPrice      Float?        // Retail Price per Strip
  boxPrice        Float?        // Retail Price per Box
  tradePrice      Float?        // Wholesale / Trade Price (TP) per unit
  tradeBoxPrice   Float?        // Wholesale / Trade Price (TP) per box
  unitsPerStrip   Int?          @default(10)
  stripsPerBox    Int?          @default(10)
  unitsPerBox     Int?          @default(100)
  vatPercentage   Float?        @default(0)

  shortages       Shortage[]
  wholesaleItems  WholesaleOrderItem[]

  @@index([brandName])
  @@index([genericName])
  @@index([isActive])
  @@index([manufacturerId])
  @@index([barcode])
}

model Shortage {
  id           String         @id @default(cuid())
  medicineId   String
  medicine     Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     User           @relation("ReportedShortages", fields: [employeeId], references: [id], onDelete: Cascade)
  quantity     Float?
  unit         String?        @default("Box")
  notes        String?
  status       ShortageStatus @default(REPORTED)
  reportedDate String         // Format: YYYY-MM-DD for fast date-based filtering and grouping
  reportedAt   DateTime       @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?        // Admin employee ID or name
  orderedAt    DateTime?
  orderedBy    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([medicineId])
  @@index([employeeId])
  @@index([reportedDate])
  @@index([reportedAt])
  @@index([status])
}

// B2B Retailer Profile (for 30+ Retailers)
model Retailer {
  id                    String            @id @default(cuid())
  retailerCode          String            @unique // e.g. RET-001, RET-002
  storeName             String            // Pharmacy / Store Name
  ownerName             String            // Proprietor / Contact Person
  phone                 String            // Contact Number
  email                 String?
  address               String            // Physical Address
  marketRoute           String?           // Market route or area (e.g. "Hospital Gate", "Bazaar Road")
  defaultDiscountPercent Float            @default(12.0) // Default trade discount % off MRP
  creditLimit           Float             @default(50000.0) // Credit limit in BDT
  currentDue            Float             @default(0.0) // Current outstanding due balance
  pinCode               String?           // Optional 4-digit PIN for quick mobile login
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  orders                WholesaleOrder[]
  payments              RetailerPayment[]

  @@index([storeName])
  @@index([retailerCode])
  @@index([phone])
  @@index([marketRoute])
  @@index([isActive])
}

// Wholesale Order
model WholesaleOrder {
  id             String               @id @default(cuid())
  orderNumber    String               @unique // e.g. WHO-20260918-001
  retailerId     String
  retailer       Retailer             @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  orderDate      String               // YYYY-MM-DD
  deliveryDate   String?              // YYYY-MM-DD
  status         OrderStatus          @default(PENDING)
  paymentStatus  PaymentStatus        @default(DUE)
  paymentMethod  PaymentMethod        @default(CASH)
  subtotal       Float                @default(0) // Sum of MRP total
  discountAmount Float                @default(0) // Trade discount deducted
  taxAmount      Float                @default(0) // VAT if applicable
  totalAmount    Float                @default(0) // Final payable after discount
  paidAmount     Float                @default(0) // Amount paid
  dueAmount      Float                @default(0) // Remaining due
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  items          WholesaleOrderItem[]
  payments       RetailerPayment[]

  @@index([retailerId])
  @@index([orderDate])
  @@index([status])
  @@index([paymentStatus])
}

// Line item in Wholesale Order
model WholesaleOrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           WholesaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineId      String
  medicine        Medicine       @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  quantity        Float          // Quantity ordered in specified unit
  unit            String         @default("Box") // Box, Strip, Tablet, Bottle
  unitPrice       Float          // MRP unit rate
  tradePrice      Float          // Wholesale rate applied
  discountPercent Float          @default(12.0)
  total           Float          // Final line total after discount
  createdAt       DateTime       @default(now())

  @@index([orderId])
  @@index([medicineId])
}

// Retailer Payment / Due Collection Ledger
model RetailerPayment {
  id            String          @id @default(cuid())
  retailerId    String
  retailer      Retailer        @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  orderId       String?
  order         WholesaleOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount        Float
  paymentMethod PaymentMethod   @default(CASH)
  referenceNo   String?         // e.g. bKash TrxID or Cheque No
  notes         String?
  paymentDate   String          // YYYY-MM-DD
  createdAt     DateTime        @default(now())

  @@index([retailerId])
  @@index([orderId])
  @@index([paymentDate])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g., "LOGIN", "BACKUP_CREATED", "MEDICINE_CREATED", "CSV_IMPORTED", "WHOLESALE_ORDER_CREATED"
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
